# SpendWise Server Environment Configuration
# Copy this file to .env and fill in your values

# Server Port (Render sets this automatically)
PORT=5001

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expensetracker?retryWrites=true&w=majority

# Client Web Application URL for CORS
# In production: set to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# Comma-separate multiple origins: https://your-app.vercel.app,https://custom-domain.com
CLIENT_URL=http://localhost:5173

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Node Environment
NODE_ENV=development

# Email (Nodemailer) - optional, for OTP/email features
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
